  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "IngestionTopic": "support.document.ingestion.v1",
    "DeadLetterTopic": "support.document.ingestion.dlq.v1",
    "ConsumerGroup": "support-copilot-indexer-v1"
  },
  "Authentication": {
